DATABASE_URL=sqlite:///./tan90.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=86400

# Copy to .env.local and fill in real values. Never commit secrets.
# Validated at startup by src/config/env.server.ts and src/config/env.public.ts.

# Public: inlined into the client bundle at build time
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server: FastAPI backend (backend/). The portal signs in as this user.
# These are the seeded Ops credentials for local development.
BACKEND_API_URL=http://127.0.0.1:8001
BACKEND_EMAIL=ops@tan90.local
BACKEND_PASSWORD=password123

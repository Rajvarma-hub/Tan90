# Template for .env.local (repo root). One file configures both the portal and the API.
# Local development works without it. Copy only to override a default.
# Production: set these as real environment variables instead.

# --- API ---
# "production" turns on safety checks and disables demo seeding.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./tan90.db
# Required in production: random, 32+ characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
JWT_TTL_SECONDS=86400
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Portal ---
# Public: inlined into the browser bundle at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_API_URL=http://127.0.0.1:8001
# Service account the portal signs in with. Required in production.
# Never reuse the demo account there.
# BACKEND_EMAIL=
# BACKEND_PASSWORD=

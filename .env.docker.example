# Template for the .env that `docker compose` reads. Copy it to `.env` and fill in the secrets.
# Do not commit `.env`.

# Letters and digits only: this goes into a database URL.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Random, 32+ characters. The API refuses to start with anything shorter.
# Generate: openssl rand -base64 48
JWT_SECRET=

# The address people type in the browser. Use https:// in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
